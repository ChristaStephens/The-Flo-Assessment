{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "TymFlo brand tokens, extracted from the approved logo and brand-guideline assets. Edit this file only; generated CSS and token exports are derived from it.",
  "color": {
    "$type": "color",
    "light": {
      "primary": { "$value": "#F69679", "$description": "TymFlo coral, used as the primary identifying color and call-to-action color." },
      "secondary": { "$value": "#EADACC", "$description": "Almond, a supporting background and quiet grouping color." },
      "accent": { "$value": "#D89000", "$description": "Harvest Gold, reserved for small highlights and secondary emphasis." },
      "background": { "$value": "#FFFDFC" },
      "foreground": { "$value": "#1E1533" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#1E1533" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#1E1533" },
      "border": { "$value": "#EADACC" },
      "input": { "$value": "#DCC9BC" },
      "ring": { "$value": "#105679" },
      "primaryForeground": { "$value": "#1E1533" },
      "secondaryForeground": { "$value": "#1E1533" },
      "muted": { "$value": "#F4C7C5" },
      "mutedForeground": { "$value": "#5A4E6B" },
      "accentForeground": { "$value": "#1E1533" },
      "destructive": { "$value": "#A64A41" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "chart1": { "$value": "#F69679" },
      "chart2": { "$value": "#105679" },
      "chart3": { "$value": "#B791C9" },
      "chart4": { "$value": "#D89000" },
      "chart5": { "$value": "#1E1533" },
      "sidebar": { "$value": "#1E1533" },
      "sidebarForeground": { "$value": "#FFFFFF" },
      "sidebarBorder": { "$value": "#46345F" },
      "sidebarPrimary": { "$value": "#F69679" },
      "sidebarPrimaryForeground": { "$value": "#1E1533" },
      "sidebarAccent": { "$value": "#46345F" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing": { "$value": "#F69679" }
    },
    "dark": {
      "primary": { "$value": "#F69679" },
      "secondary": { "$value": "#46345F" },
      "accent": { "$value": "#D89000" },
      "background": { "$value": "#1E1533" },
      "foreground": { "$value": "#FFFFFF" },
      "card": { "$value": "#2D2148" },
      "cardForeground": { "$value": "#FFFFFF" },
      "popover": { "$value": "#2D2148" },
      "popoverForeground": { "$value": "#FFFFFF" },
      "border": { "$value": "#5E4B78" },
      "input": { "$value": "#5E4B78" },
      "ring": { "$value": "#F69679" },
      "primaryForeground": { "$value": "#1E1533" },
      "secondaryForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#46345F" },
      "mutedForeground": { "$value": "#D9CDE2" },
      "accentForeground": { "$value": "#1E1533" },
      "destructive": { "$value": "#F39679" },
      "destructiveForeground": { "$value": "#1E1533" },
      "chart1": { "$value": "#F69679" },
      "chart2": { "$value": "#68A9C8" },
      "chart3": { "$value": "#D9B7E5" },
      "chart4": { "$value": "#F0BD55" },
      "chart5": { "$value": "#EADACC" },
      "sidebar": { "$value": "#1E1533" },
      "sidebarForeground": { "$value": "#FFFFFF" },
      "sidebarBorder": { "$value": "#46345F" },
      "sidebarPrimary": { "$value": "#F69679" },
      "sidebarPrimaryForeground": { "$value": "#1E1533" },
      "sidebarAccent": { "$value": "#46345F" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing": { "$value": "#F69679" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Montserrat", "sans-serif"], "$description": "Montserrat Semi Bold for primary headings and a modern, professional interface." },
      "serif": { "$value": ["Spectral", "Georgia", "serif"], "$description": "Spectral Regular and Medium Italic for subheadings and body copy." },
      "mono": { "$value": ["Montserrat", "sans-serif"], "$description": "Use compact uppercase Montserrat labels rather than a technical monospace face." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.5rem", "$description": "Clean, professional corners that support a modern 2D visual system." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Four-pixel base rhythm, composed into compact labels and generous editorial sections." }
  }
}